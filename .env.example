# ==========================================
# Backend Environment Configuration Template
# ==========================================

# Server Port (Railway automatically sets the PORT variable)
PORT=8002

# Railway MySQL Configuration
# In Railway: If you connect a MySQL database, Railway injects these automatically.
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=csrm_db
MYSQLUSER=root
MYSQLPASSWORD=1234

# Alternative full Spring Datasource URL (Must start with jdbc:mysql://):
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/csrm_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=1234

# Security / JWT Secret (at least 32 characters)
JWT_SECRET=csrm-secret-key-for-jwt-signing-minimum-32-characters-long
JWT_EXPIRATION=86400000

# CORS Allowed Origins (comma-separated, or * to allow all origins)
# For production on Railway: set to your frontend domain, e.g. https://<your-frontend>.up.railway.app
CORS_ALLOWED_ORIGINS=*

